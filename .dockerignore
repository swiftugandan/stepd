# The build context is the repo root but only `rust/` is copied. Excluding the
# rest keeps the context small; excluding rust/target keeps a host build from
# being shipped into the image, where its absolute paths and host glibc are
# wrong anyway.
.git
.github
.claude
docs
spec
reference
rust/target
**/*.md
**/.venv
**/__pycache__
.env
.env.*
