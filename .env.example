# Copy to .env and fill in:  cp .env.example .env
#
# Compose refuses to start without the two marked REQUIRED rather than
# inventing defaults for them.

# ---- database
POSTGRES_USER=stepd
POSTGRES_PASSWORD=            # REQUIRED
POSTGRES_DB=stepd

# ---- server
STEPD_PORT=8080

# REQUIRED. Signs every attempt the server sends; the app verifies with the
# same key (protocol §9). `stepd serve` refuses to start without it.
#   openssl rand -hex 32
STEPD_SIGNING_KEY=

# Set only during a rotation: both keys verify, the first signs. Leave the line
# out entirely when not rotating.
# STEPD_SIGNING_KEY_PREVIOUS=

# ---- managed blobs
# Separate key: one says "this server sent this attempt", the other says "the
# bearer may write these exact bytes once". Leave empty to disable the transfer
# endpoints — they answer 501 and say why. There is no default.
#   openssl rand -hex 32
STEPD_BLOB_SIGNING_KEY=

# What apps are handed for upload and download URLs.
#   http://localhost:8080  an app running on the host
#   http://stepd:8080      an app running on this compose network
STEPD_BLOB_BASE_URL=http://localhost:8080
STEPD_BLOB_MAX_SIZE=104857600

# ---- managed blobs: S3 backend
# Leaving STEPD_BLOB_BACKEND unset (or "fs") keeps the filesystem-plus-relay
# default above, which is what makes `stepd dev` and CI work with no object
# store. Set it to "s3" to presign uploads and downloads directly against an
# S3-compatible store instead — see docs/blob-backends.md for which servers
# this has actually been verified against before picking one.
#
# All four of endpoint, bucket, access key and secret key are required once
# STEPD_BLOB_BACKEND=s3; the server refuses to start rather than hand out
# upload URLs against a bucket that half exists.
# STEPD_BLOB_BACKEND=s3
# STEPD_BLOB_S3_ENDPOINT=http://minio:9000
# STEPD_BLOB_S3_REGION=us-east-1
# STEPD_BLOB_S3_BUCKET=stepd
# STEPD_BLOB_S3_ACCESS_KEY=
# STEPD_BLOB_S3_SECRET_KEY=
#
# Read BY VALUE ("1"/"true" or "0"/"false"), unlike the three egress flags
# below — those are read by presence, where setting one to "0" still enables
# it. A path-style flag with the same convention would mean "=0" silently
# turns virtual-host addressing on against a server with no DNS for it.
# Required by most self-hosted servers, which have no wildcard DNS for
# bucket.host; real AWS wants this left false (or unset).
# STEPD_BLOB_S3_PATH_STYLE=true

# ---- egress
# Read by PRESENCE, not by value: STEPD_ALLOW_PRIVATE_EGRESS=0 enables private
# egress. To disable, comment the line out. To enable, any value will do.
#
# An app on this compose network has an RFC 1918 address, so it needs this set.
# Cloud metadata addresses stay denied either way.
# STEPD_ALLOW_PRIVATE_EGRESS=1
# STEPD_ALLOW_LOOPBACK_EGRESS=1
# STEPD_EGRESS_ALLOWLIST=app.internal,billing.internal

# ---- dispatch
# The lease must outlast the attempt, with room for the response to come back.
# Equal values mean a slow-but-healthy app is reclaimed mid-attempt and its step
# re-executed; the server warns at startup if you break the inequality.
STEPD_ATTEMPT_TIMEOUT_SECONDS=60
STEPD_LEASE_SECONDS=150
STEPD_BATCH=16
STEPD_MAX_CONNECTIONS=16
STEPD_IDLE_POLL_MS=250
STEPD_TIMER_JITTER_SECONDS=60

# ---- bootstrap / logging
STEPD_NAMESPACE=default
STEPD_LOG=info
# STEPD_LOG_JSON=1
