{
  "name": "@stepd/sdk-core",
  "version": "0.1.0",
  "description": "The replay machinery of the stepd TypeScript SDK: eager occurrence claiming, memo lookup and short-circuit control flow. No I/O, no HTTP.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@stepd/protocol": "link:../../../../spec/typescript"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
