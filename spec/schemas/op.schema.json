{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stepd.dev/schemas/v1/op.schema.json",
  "title": "stepd Op",
  "description": "One control instruction returned by an SDK to the server",
  "oneOf": [
    {
      "$ref": "#/$defs/step"
    },
    {
      "$ref": "#/$defs/sleep"
    },
    {
      "$ref": "#/$defs/waitEvent"
    },
    {
      "$ref": "#/$defs/invoke"
    },
    {
      "$ref": "#/$defs/signal"
    },
    {
      "$ref": "#/$defs/done"
    },
    {
      "$ref": "#/$defs/error"
    },
    {
      "$ref": "#/$defs/continueAsNew"
    }
  ],
  "$defs": {
    "base": {
      "type": "object",
      "required": [
        "op",
        "id",
        "hash"
      ],
      "properties": {
        "op": {
          "type": "string"
        },
        "id": {
          "$ref": "common.schema.json#/$defs/stepId"
        },
        "hash": {
          "$ref": "common.schema.json#/$defs/stepHash"
        },
        "started_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "meta": {
          "type": "object",
          "description": "Free-form observability metadata; receivers MUST ignore unknown keys",
          "properties": {
            "tokens_in": {
              "type": "integer",
              "minimum": 0
            },
            "tokens_out": {
              "type": "integer",
              "minimum": 0
            },
            "cost_usd": {
              "type": "number",
              "minimum": 0
            },
            "model": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "attempt_of_step": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": true
        }
      }
    },
    "step": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "type": "object",
      "required": [
        "op",
        "id",
        "hash"
      ],
      "properties": {
        "op": {
          "const": "step"
        },
        "data": {
          "$ref": "common.schema.json#/$defs/payload"
        },
        "error": {
          "$ref": "common.schema.json#/$defs/error"
        }
      },
      "unevaluatedProperties": false,
      "description": "A unit of work that reached a terminal outcome. `data` carries a result; `error` marks a body that raised non-retryably and is recorded as a failed step. A retryable failure MUST NOT be sent here - it would be memoised and the retry would never re-execute the body (PROTOCOL 5.2.2).",
      "not": {
        "required": [
          "data",
          "error"
        ],
        "description": "A step has one outcome: a result or a failure, never both."
      }
    },
    "sleep": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "type": "object",
      "required": [
        "op",
        "id",
        "hash"
      ],
      "oneOf": [
        {
          "required": [
            "until"
          ]
        },
        {
          "required": [
            "duration"
          ]
        }
      ],
      "properties": {
        "op": {
          "const": "sleep"
        },
        "until": {
          "$ref": "common.schema.json#/$defs/timestamp"
        },
        "duration": {
          "$ref": "common.schema.json#/$defs/duration"
        }
      },
      "unevaluatedProperties": false
    },
    "waitEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "type": "object",
      "required": [
        "op",
        "id",
        "hash",
        "event"
      ],
      "properties": {
        "op": {
          "const": "wait_event"
        },
        "event": {
          "type": "string",
          "minLength": 1
        },
        "expr": {
          "$ref": "common.schema.json#/$defs/cel"
        },
        "timeout": {
          "$ref": "common.schema.json#/$defs/duration"
        },
        "prompt": {
          "type": "object",
          "description": "Presentational only; rendered in the console as a pending action",
          "properties": {
            "title": {
              "type": "string",
              "maxLength": 256
            },
            "detail": {},
            "actions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "label",
                  "event"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "event": {
                    "type": "string"
                  },
                  "data": {}
                }
              }
            }
          }
        },
        "since": {
          "description": "Matching window for the run inbox. Defaults to run_start, which prevents the lost-signal race.",
          "default": "run_start",
          "anyOf": [
            {
              "enum": [
                "run_start",
                "registration"
              ]
            },
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}[Tt]\\d{2}:\\d{2}:\\d{2}(\\.\\d+)?([Zz]|[+-]\\d{2}:\\d{2})$"
            }
          ]
        }
      },
      "unevaluatedProperties": false
    },
    "invoke": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "type": "object",
      "required": [
        "op",
        "id",
        "hash",
        "function"
      ],
      "properties": {
        "op": {
          "const": "invoke"
        },
        "function": {
          "$ref": "common.schema.json#/$defs/identifier"
        },
        "input": {
          "$ref": "common.schema.json#/$defs/payload"
        },
        "key": {
          "type": "string",
          "maxLength": 512
        },
        "timeout": {
          "$ref": "common.schema.json#/$defs/duration"
        },
        "detach": {
          "type": "boolean",
          "default": false
        }
      },
      "unevaluatedProperties": false
    },
    "signal": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "type": "object",
      "required": [
        "op",
        "id",
        "hash",
        "event"
      ],
      "properties": {
        "op": {
          "const": "signal"
        },
        "target_run": {
          "$ref": "common.schema.json#/$defs/uuidv7"
        },
        "target_key": {
          "type": "string"
        },
        "event": {
          "$ref": "event.schema.json"
        }
      },
      "unevaluatedProperties": false
    },
    "done": {
      "type": "object",
      "required": [
        "op"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "done"
        },
        "data": {
          "$ref": "common.schema.json#/$defs/payload"
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "op",
        "error"
      ],
      "additionalProperties": false,
      "properties": {
        "op": {
          "const": "error"
        },
        "retryable": {
          "type": "boolean",
          "default": true
        },
        "step": {
          "$ref": "common.schema.json#/$defs/stepId"
        },
        "hash": {
          "$ref": "common.schema.json#/$defs/stepHash"
        },
        "error": {
          "$ref": "common.schema.json#/$defs/error"
        }
      }
    },
    "continueAsNew": {
      "allOf": [
        {
          "$ref": "#/$defs/base"
        }
      ],
      "type": "object",
      "required": [
        "op",
        "id",
        "hash"
      ],
      "properties": {
        "op": {
          "const": "continue_as_new"
        },
        "input": {
          "$ref": "common.schema.json#/$defs/payload"
        },
        "carry": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "common.schema.json#/$defs/stepId"
          },
          "description": "Step ids whose results are copied into the successor's input under `carried`"
        }
      },
      "unevaluatedProperties": false
    }
  }
}
